ns DerCooleVonDem\StructureTool\command\subCommands;

use DerCooleVonDem\ZetNexHealth\command\HealthSubCommand,
    pocketmine\command\CommandSender;

TestSubCommand : HealthSubCommand {

    () {
        parent.__construct("test", "Oh noes, there is a test sub remaining!");
    }

    pu execute($sender CommandSender, $args array) {
        $sender.sendMessage("Test");
    }

}